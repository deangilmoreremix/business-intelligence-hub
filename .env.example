# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OpenAI (Responses API + Images API). Key lives ONLY on Netlify (server side):
#   Netlify site settings -> Environment variables -> OPENAI_API_KEY
# Optional model overrides (client reads these; defaults shown)
VITE_OPENAI_MODEL=gpt-6-astra
VITE_OPENAI_FAST_MODEL=gpt-6.1-terra
VITE_OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
# Local dev only (calls api.openai.com directly, never ship this to production):
# VITE_OPENAI_API_KEY=

# Module Federation
VITE_HOST_ORIGIN=
VITE_REMOTE_NAME=
VITE_REMOTE_PORT=
VITE_REMOTE_URL=

# ---- Netlify SERVER-SIDE environment variables (Netlify site settings, never VITE_*) ----
# OPENAI_API_KEY=            required: used only by netlify/functions/openai-proxy
# ALLOWED_ORIGIN=            the host app origin; REQUIRED in production (proxy and crm refuse to run without it)
# HOST_JWT_SECRET=           HS256 secret shared with the host CRM; when set, a valid bearer token is required.
#                            Use the Supabase project's JWT secret so the same token also scopes database rows by tenant.
# HOST_JWT_ISSUER=          optional: required `iss` claim
# REQUIRE_AUTH=true          refuse all requests if HOST_JWT_SECRET is missing
# RATE_LIMIT_PER_MIN=30      per-tenant requests/minute to the OpenAI proxy (in memory, per function instance)
# SUPABASE_URL=              server-side Supabase URL (crm function)
# SUPABASE_SERVICE_ROLE_KEY= service role key (crm function ONLY; never expose to the browser)
# CRM_ALLOWED_HOSTS=         optional comma-separated allowlist of CRM hostnames

# Host app -> this app: post {type:'AUTH_TOKEN', data:'<jwt>'} from VITE_HOST_ORIGIN.
# JWT claims: tenant_id (string), exp (seconds), and for Supabase row scoping: role = "authenticated".

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OpenAI (Responses API + Images API). Key lives ONLY on Netlify (server side):
#   Netlify site settings -> Environment variables -> OPENAI_API_KEY
# Optional model overrides (client reads these; defaults shown)
VITE_OPENAI_MODEL=gpt-6-astra
VITE_OPENAI_FAST_MODEL=gpt-6.1-terra
VITE_OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
# Local dev only (calls api.openai.com directly, never ship this to production):
# VITE_OPENAI_API_KEY=

# Module Federation
VITE_HOST_ORIGIN=
VITE_REMOTE_NAME=
VITE_REMOTE_PORT=
VITE_REMOTE_URL=

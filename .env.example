# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenAI Configuration - GPT-5 READY! ✅
VITE_OPENAI_API_KEY=your_openai_api_key
VITE_OPENAI_MODEL=gpt-4o  # Options: gpt-5, gpt-5-thinking, gpt-5-mini, gpt-4o, gpt-4o-mini
                           # GPT-5 automatically uses reasoning & verbosity parameters!

# Google Gemini Configuration (Optional)
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_GEMINI_MODEL=gemini-2.0-flash-exp

# Module Federation Configuration
# The origin of the host application (SmartCRM)
VITE_HOST_ORIGIN=https://smartcrm-videoremix.replit.app

# The name of this remote application (must match vite.config.ts)
VITE_REMOTE_NAME=AnalyticsApp

# The port this app runs on for Module Federation
VITE_REMOTE_PORT=5000

# Production deployment URL (where remoteEntry.js will be accessible)
VITE_REMOTE_URL=https://ai-analytics.smartcrm.vip
{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    // unused vars are enforced by eslint (vendored Twenty sources are not ours to edit)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strictPropertyInitialization": false,
    "noFallthroughCasesInSwitch": true,

    /* Vendored Twenty import aliases (mirrored in vite.config.ts) */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/vendor/twenty/front/modules/*"],
      "~/*": ["src/vendor/twenty/front/*"],
      "twenty-shared/*": ["src/vendor/twenty/shared/*"],
      "twenty-front-component-renderer": ["src/vendor/twenty-adapter/front-component-renderer.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/vendor/twenty", "src/vendor/twenty-adapter/probe.test.ts"]
}
